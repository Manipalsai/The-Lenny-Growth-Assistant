# ============================================================
# The Lenny Growth Assistant - Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL + pgvector or local fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
# If PostgreSQL is not running locally, SQLite fallback can be used automatically:
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=lenny_growth.db

# LLM Provider Configuration
# Options: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama Settings (Local Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM Settings (OpenAI / Anthropic fallback & Vercel production)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Fallback Configuration
ENABLE_FALLBACK=true
FALLBACK_PROVIDER=openai

# Embeddings Configuration
# Options: hash (lightweight zero-dependency), sentence-transformers (all-MiniLM-L6-v2), or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app

# Logging & Observability
LOG_LEVEL=INFO
